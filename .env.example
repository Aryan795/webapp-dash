# Base URL of your Home Assistant instance (no trailing slash)
HA_URL=http://homeassistant.local:8123
# Long-lived access token (HA profile -> Security -> Long-lived access tokens)
HA_TOKEN=paste-token-here
# Port the dashboard server listens on (and is published on)
PORT=8080
# Optional: publish on one host address only. Unset = all interfaces, which is
# what a LAN wall panel plus tailnet phones need. Binding to a Tailscale IP
# also needs net.ipv4.ip_nonlocal_bind=1 on the host (see README).
#BIND_ADDR=100.64.0.1
# Optional: extra browser origins allowed to open the socket, e.g. a reverse
# proxy's public URL. The dashboard's own origin is always allowed.
#ALLOWED_ORIGINS=https://dash.example.ts.net
